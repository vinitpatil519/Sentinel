# Scripts, units and firmware config run on Linux hosts. A CRLF checkout
# (Windows with core.autocrlf) breaks the shebang line ("bash\r: No such file")
# and systemd's parser, so these always check out with LF.
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
sdkconfig.* text eol=lf
